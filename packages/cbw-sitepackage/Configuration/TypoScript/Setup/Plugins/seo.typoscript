plugin.tx_seo {
    view {
        # cat=plugin.tx_seo/file; type=string; label=Path to template root (FE)
        templateRootPath = EXT:cbw_sitepackage/Resources/Private/Templates/Seo/XmlSitemap
        # cat=plugin.tx_seo/file; type=string; label=Path to template partials (FE)
        partialRootPath = EXT:cbw_sitepackage/Resources/Private/Templates/Seo/XmlSitemap
        # cat=plugin.tx_seo/file; type=string; label=Path to template layouts (FE)
        layoutRootPath = EXT:cbw_sitepackage/Resources/Private/Templates/Seo/XmlSitemap
    }

    settings {
        xmlSitemap {
            sitemaps {
                pages {
                    excludedDoktypes = 3, 6, 7, 199, 254, 255
                    additionalWhere = AND (no_index = 0 OR no_follow = 0)
                }
            }
        }
    }
}

seo_sitemap = PAGE
seo_sitemap {
    typeNum = 1533906435

    config {
        cache_period = 900
        disableAllHeaderCode = 1
        admPanel = 0
        removeDefaultJS = 1
        removeDefaultCss = 1
        removePageCss = 1
        additionalHeaders.10 {
            header = Content-Type:application/xml;charset=utf-8
        }
    }

    10 = USER
    10.userFunc = TYPO3\CMS\Seo\XmlSitemap\XmlSitemapRenderer->render
}