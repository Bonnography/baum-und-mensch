                        rows {
                            1 {
                                columns {
                                    1 {
                                        name = Headerimage
                                        colPos = 0
                                    }
                                }
                            }
                            2 {
                                columns {
                                    1 {
                                        name = LLL:EXT:cbw_sitepackage/Resources/Private/Language/locallang_be.xlf:backend_layout.column.normal
                                        colPos = 5
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}