mod.wizards.newContentElement.wizardItems.common {
    elements {
        slider {
            iconIdentifier = content-carousel-image
            title = LLL:EXT:cbw_sitepackage/Resources/Private/Language/locallang_tca.xlf:tt_content.slider.wizard.title
            description = LLL:EXT:cbw_sitepackage/Resources/Private/Language/locallang_tca.xlf:tt_content.slider.wizard.description
            tt_content_defValues {
                CType = slider
            }
        }
    }
    show := addToList(slider)
}