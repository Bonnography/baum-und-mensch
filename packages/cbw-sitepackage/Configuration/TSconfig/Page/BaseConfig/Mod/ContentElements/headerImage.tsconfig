mod.wizards.newContentElement.wizardItems.common {
    elements {
        headerImage {
            iconIdentifier = content-image
            title = LLL:EXT:cbw_sitepackage/Resources/Private/Language/locallang_tca.xlf:tt_content.headerImage.wizard.title
            description = LLL:EXT:cbw_sitepackage/Resources/Private/Language/locallang_tca.xlf:tt_content.headerImage.wizard.description
            tt_content_defValues {
                CType = headerImage
            }
        }
    }
    show := addToList(headerImage)
}